{
  "info": {
    "name": "SiteLog API",
    "description": "MTN Laravel intern task. Login first, the Tests script on the login request saves the token. All seeded accounts use the password 'password'.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000" },
    { "key": "token", "value": "" },
    { "key": "region_id", "value": "" },
    { "key": "site_id", "value": "" },
    { "key": "report_id", "value": "" },
    { "key": "fault_id", "value": "" },
    { "key": "engineer_id", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login as admin",
          "auth": { "type": "noauth" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"token\", body.data.token);",
                  "pm.collectionVariables.set(\"engineer_id\", \"\");"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{base_url}}/api/v1/auth/login", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@sitelog.test\",\n  \"password\": \"password\"\n}"
            }
          }
        },
        {
          "name": "Login as manager1",
          "auth": { "type": "noauth" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["const body = pm.response.json();", "pm.collectionVariables.set(\"token\", body.data.token);"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{base_url}}/api/v1/auth/login", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"manager1@sitelog.test\",\n  \"password\": \"password\"\n}"
            }
          }
        },
        {
          "name": "Login as engineer1",
          "auth": { "type": "noauth" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"token\", body.data.token);",
                  "pm.collectionVariables.set(\"engineer_id\", String(body.data.user.id));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{base_url}}/api/v1/auth/login", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"engineer1@sitelog.test\",\n  \"password\": \"password\"\n}"
            }
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/v1/auth/me", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "me"] }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/v1/auth/logout", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "logout"] }
          }
        }
      ]
    },
    {
      "name": "Regions",
      "item": [
        {
          "name": "List regions",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/v1/regions", "host": ["{{base_url}}"], "path": ["api", "v1", "regions"] }
          }
        },
        {
          "name": "Create region (admin only)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{base_url}}/api/v1/regions", "host": ["{{base_url}}"], "path": ["api", "v1", "regions"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Demo Region\",\n  \"code\": \"demo\",\n  \"manager_id\": 2\n}"
            }
          }
        },
        {
          "name": "Region summary",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v1/regions/1/summary",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "regions", "1", "summary"]
            }
          }
        }
      ]
    },
    {
      "name": "Sites",
      "item": [
        {
          "name": "List sites",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/v1/sites?per_page=5", "host": ["{{base_url}}"], "path": ["api", "v1", "sites"], "query": [{ "key": "per_page", "value": "5" }] }
          }
        },
        {
          "name": "Search sites",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/v1/sites?search=LAG", "host": ["{{base_url}}"], "path": ["api", "v1", "sites"], "query": [{ "key": "search", "value": "LAG" }] }
          }
        },
        {
          "name": "Show site",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v1/sites/1",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "sites", "1"]
            }
          }
        },
        {
          "name": "Create site (admin only)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{base_url}}/api/v1/sites", "host": ["{{base_url}}"], "path": ["api", "v1", "sites"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"site_code\": \"DEMO-0001\",\n  \"name\": \"Demo Site One\",\n  \"region_id\": 1,\n  \"address\": \"1 Demo Road\",\n  \"latitude\": 6.5244,\n  \"longitude\": 3.3792,\n  \"site_type\": \"greenfield\",\n  \"power_source\": \"hybrid\"\n}"
            }
          }
        },
        {
          "name": "Assign engineer to site",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v1/sites/1/engineers/{{engineer_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "sites", "1", "engineers", "{{engineer_id}}"]
            }
          }
        },
        {
          "name": "Site summary",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v1/sites/1/summary",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "sites", "1", "summary"]
            }
          }
        }
      ]
    },
    {
      "name": "Reports",
      "item": [
        {
          "name": "List reports",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v1/reports?status=approved&per_page=5",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "reports"],
              "query": [
                { "key": "status", "value": "approved" },
                { "key": "per_page", "value": "5" }
              ]
            }
          }
        },
        {
          "name": "Create draft report",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set(\"report_id\", String(pm.response.json().data.id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/sites/1/reports",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "sites", "1", "reports"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"visit_date\": \"2026-11-21\",\n  \"visit_type\": \"routine\",\n  \"grid_power_available\": true,\n  \"generator_hours\": 5.5,\n  \"fuel_level_percent\": 65,\n  \"battery_health\": \"good\",\n  \"work_summary\": \"Routine inspection. Topped up diesel.\",\n  \"maintenance_items\": [\n    { \"item_name\": \"diesel\", \"action\": \"refilled\", \"quantity\": 20, \"unit\": \"litres\" }\n  ]\n}"
            }
          }
        },
        {
          "name": "Submit report",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v1/reports/{{report_id}}/submit",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "reports", "{{report_id}}", "submit"]
            }
          }
        },
        {
          "name": "Approve report (manager or admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/reports/{{report_id}}/approve",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "reports", "{{report_id}}", "approve"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"review_comment\": \"Looks good\"\n}"
            }
          }
        },
        {
          "name": "Reject report (comment required)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/reports/{{report_id}}/reject",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "reports", "{{report_id}}", "reject"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"review_comment\": \"Fuel reading does not match the photo.\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Faults",
      "item": [
        {
          "name": "List faults",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/v1/faults", "host": ["{{base_url}}"], "path": ["api", "v1", "faults"] }
          }
        },
        {
          "name": "SLA breached faults",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v1/faults?sla_breached=1",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "faults"],
              "query": [{ "key": "sla_breached", "value": "1" }]
            }
          }
        },
        {
          "name": "Raise fault",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set(\"fault_id\", String(pm.response.json().data.id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/sites/1/faults",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "sites", "1", "faults"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Generator down\",\n  \"description\": \"Generator failed to start during checks.\",\n  \"category\": \"power\",\n  \"severity\": \"high\"\n}"
            }
          }
        },
        {
          "name": "Move fault to in progress",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/faults/{{fault_id}}/status",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "faults", "{{fault_id}}", "status"]
            },
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"in_progress\"\n}" }
          }
        },
        {
          "name": "Move fault to resolved",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/faults/{{fault_id}}/status",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "faults", "{{fault_id}}", "status"]
            },
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"resolved\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Photos",
      "item": [
        {
          "name": "Upload photos to a report",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v1/reports/{{report_id}}/photos",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "reports", "{{report_id}}", "photos"]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "photos[]", "type": "file", "src": [] },
                { "key": "caption", "value": "Meter reading", "type": "text" }
              ]
            }
          }
        },
        {
          "name": "Upload photos to a fault",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v1/faults/{{fault_id}}/photos",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "faults", "{{fault_id}}", "photos"]
            },
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "photos[]", "type": "file", "src": [] }]
            }
          }
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        {
          "name": "List notifications",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v1/notifications",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "notifications"]
            }
          }
        }
      ]
    }
  ]
}
